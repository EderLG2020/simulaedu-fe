{
  "name": "simulaedu-fe",
  "private": true,
  "version": "0.1.0",
  "description": "Monorepo frontend de SimulaEdu: app web (apps/web) y paquetes compartidos (packages/*).",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @simulaedu/web dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "knip": "node packages/architecture/knip-with-baseline.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.0",
    "eslint-plugin-boundaries": "7.4.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "knip": "6.44.1",
    "turbo": "2.11.10",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.67.0"
  }
}
